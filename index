<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Katak Melompat: Petualangan Kolam</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Quicksand:wght@500;700&display=swap" rel="stylesheet">
    <style>
        * {
            user-select: none;
            -webkit-user-select: none;
            -webkit-touch-callout: none;
            touch-action: manipulation;
        }
        html, body {
            width: 100%;
            height: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden;
            background-color: #061a14;
            font-family: 'Quicksand', sans-serif;
        }
        .font-game {
            font-family: 'Fredoka One', cursive;
        }
        .glass-panel {
            background: rgba(15, 43, 38, 0.88);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 2px solid rgba(52, 211, 153, 0.35);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
        }
        .btn-bounce {
            transition: transform 0.1s ease, box-shadow 0.1s ease, background-color 0.2s ease;
        }
        .btn-bounce:active {
            transform: scale(0.95);
        }
        @keyframes floatAnim {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-8px); }
        }
        .animate-float {
            animation: floatAnim 2.5s ease-in-out infinite;
        }
    </style>
</head>
<body class="w-screen h-screen flex flex-col items-center justify-between relative overflow-hidden select-none">

    <!-- Game Layout Container -->
    <div class="relative w-full h-full max-w-4xl flex flex-col items-center justify-between p-2 sm:p-4 z-10">
        
        <!-- Top HUD Header -->
        <header class="w-full glass-panel rounded-2xl p-2.5 sm:p-4 flex justify-between items-center z-20 border border-emerald-500/30 shrink-0">
            <div class="flex items-center space-x-2 sm:space-x-3">
                <div class="w-9 h-9 sm:w-11 sm:h-11 rounded-xl bg-emerald-500/20 border border-emerald-400 flex items-center justify-center text-xl sm:text-2xl shadow-inner">
                    🐸
                </div>
                <div>
                    <h1 class="text-[10px] sm:text-xs uppercase tracking-wider text-emerald-300 font-bold">Tingkat</h1>
                    <div id="levelDisplay" class="text-sm sm:text-xl font-game text-emerald-100 leading-tight">1 - Kolam Tenang</div>
                </div>
            </div>

            <!-- Score & Target -->
            <div class="flex space-x-4 sm:space-x-8 text-center">
                <div>
                    <span class="text-[10px] sm:text-xs uppercase text-emerald-300 font-bold block">Skor</span>
                    <span id="scoreDisplay" class="text-base sm:text-2xl font-game text-yellow-300 drop-shadow">0</span>
                </div>
                <div>
                    <span class="text-[10px] sm:text-xs uppercase text-emerald-300 font-bold block">Target</span>
                    <span id="targetDisplay" class="text-base sm:text-2xl font-game text-emerald-200">0/5</span>
                </div>
            </div>

            <!-- Sound Toggle Button -->
            <button id="soundBtn" aria-label="Toggle Sound" class="w-9 h-9 sm:w-11 sm:h-11 rounded-xl bg-emerald-700/40 hover:bg-emerald-600/50 flex items-center justify-center text-lg sm:text-xl transition border border-emerald-400/40 active:scale-90">
                🔊
            </button>
        </header>

        <!-- Main Game Canvas Container -->
        <main class="relative w-full flex-1 my-2 rounded-2xl overflow-hidden shadow-2xl border-2 border-emerald-600/40 bg-teal-950 flex items-center justify-center">
            <canvas id="gameCanvas" class="w-full h-full block cursor-pointer touch-none"></canvas>

            <!-- Charge Power Visual Indicator (Bottom Overlay) -->
            <div id="powerContainer" class="absolute bottom-4 left-1/2 transform -translate-x-1/2 w-64 sm:w-80 bg-emerald-950/90 p-2.5 rounded-xl border border-emerald-400/50 opacity-0 transition-opacity duration-150 pointer-events-none shadow-xl">
                <div class="text-center text-xs font-bold text-emerald-200 mb-1 flex justify-between px-1">
                    <span>DAYA LOMPAT</span>
                    <span id="powerPercent" class="text-yellow-300 font-game">0%</span>
                </div>
                <div class="w-full h-4 bg-emerald-900/80 rounded-lg overflow-hidden border border-emerald-700">
                    <div id="powerBar" class="h-full w-0 bg-gradient-to-r from-yellow-400 via-orange-500 to-red-500 transition-all duration-75"></div>
                </div>
            </div>

            <!-- Instruction Overlay Banner -->
            <div id="instructionBanner" class="absolute top-4 left-1/2 transform -translate-x-1/2 bg-black/60 backdrop-blur px-3 py-1.5 rounded-full border border-emerald-400/40 text-[11px] sm:text-xs text-emerald-200 text-center pointer-events-none animate-bounce shadow-md">
                💡 Tekan & Tahan <span class="bg-emerald-600 text-white px-1.5 py-0.5 rounded font-bold">SPACE</span> / <span class="bg-emerald-600 text-white px-1.5 py-0.5 rounded font-bold">TAP LAYAR</span> lalu Lepas!
            </div>
        </main>

        <!-- Footer Control Helper -->
        <footer class="w-full text-center text-[11px] sm:text-xs text-emerald-400/80 font-medium py-1 shrink-0">
            Kontrol HP: Sentuh & Tahan Layar | Laptop/PC: Tahan Tombol Spacebar
        </footer>
    </div>

    <!-- 1. Start Menu Modal -->
    <div id="startModal" class="fixed inset-0 bg-black/85 backdrop-blur-md flex items-center justify-center z-50 p-4">
        <div class="glass-panel p-6 sm:p-8 rounded-3xl max-w-md w-full text-center border-2 border-emerald-400/50 relative shadow-2xl">
            <div class="w-20 h-20 bg-emerald-500/20 rounded-full flex items-center justify-center mx-auto mb-4 border-2 border-emerald-400 animate-float text-5xl shadow-lg">
                🐸
            </div>
            <h2 class="text-3xl sm:text-4xl font-game text-emerald-300 mb-2 drop-shadow">KATAK LOMPAT</h2>
            <p class="text-emerald-100 text-xs sm:text-sm mb-5 leading-relaxed font-medium">
                Bantu Si Katak menyeberangi kolam! Tahan untuk mengisi daya lompatan, perhatikan garis petunjuk, lalu lepaskan dengan tepat agar tidak tenggelam.
            </p>

            <div class="bg-emerald-950/60 p-3.5 rounded-2xl text-left text-xs text-emerald-200 space-y-2 mb-6 border border-emerald-700/60">
                <div class="flex items-center space-x-2">
                    <span class="text-base">⌨️</span>
                    <span><strong>Laptop/PC:</strong> Tahan <kbd class="bg-emerald-800 px-1.5 py-0.5 rounded border border-emerald-600 font-mono text-[10px]">Spacebar</kbd> lalu lepas.</span>
                </div>
                <div class="flex items-center space-x-2">
                    <span class="text-base">📱</span>
                    <span><strong>HP/Tablet:</strong> Sentuh & Tahan Layar lalu lepas.</span>
                </div>
                <div class="flex items-center space-x-2">
                    <span class="text-base">🎯</span>
                    <span>Dapatkan bonus poin mendarat tepat di tengah teratai!</span>
                </div>
            </div>

            <button id="startBtn" class="w-full py-4 bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-white font-game text-xl rounded-2xl shadow-xl border border-emerald-300/50 btn-bounce cursor-pointer">
                MULAI PETUALANGAN
            </button>
        </div>
    </div>

    <!-- 2. Level Complete Modal -->
    <div id="levelModal" class="fixed inset-0 bg-black/85 backdrop-blur-md flex items-center justify-center z-50 p-4 hidden">
        <div class="glass-panel p-6 sm:p-8 rounded-3xl max-w-md w-full text-center border-2 border-yellow-400/50 shadow-2xl">
            <div class="text-5xl mb-2 animate-bounce">🌟</div>
            <h2 class="text-3xl font-game text-yellow-300 mb-1">LEVEL SELESAI!</h2>
            <p id="levelCompleteSub" class="text-emerald-200 text-xs sm:text-sm mb-4">Kamu berhasil menyeberangi kolam ini!</p>

            <div class="bg-emerald-950/70 p-4 rounded-2xl my-4 border border-emerald-500/40">
                <div class="text-xs text-emerald-300 uppercase font-bold tracking-wider">Total Skor Saat Ini</div>
                <div id="levelScoreText" class="text-4xl font-game text-yellow-400 my-1">0</div>
            </div>

            <button id="nextLevelBtn" class="w-full py-3.5 bg-gradient-to-r from-yellow-500 to-amber-600 hover:from-yellow-400 hover:to-amber-500 text-white font-game text-lg rounded-2xl shadow-xl border border-yellow-300/50 btn-bounce cursor-pointer">
                LEVEL SELANJUTNYA ➔
            </button>
        </div>
    </div>

    <!-- 3. Game Over Modal -->
    <div id="gameOverModal" class="fixed inset-0 bg-black/90 backdrop-blur-md flex items-center justify-center z-50 p-4 hidden">
        <div class="glass-panel p-6 sm:p-8 rounded-3xl max-w-md w-full text-center border-2 border-red-500/50 shadow-2xl">
            <div class="text-5xl mb-2">💦</div>
            <h2 class="text-3xl font-game text-red-400 mb-1">BYURRR! TENGGELAM!</h2>
            <p class="text-emerald-200 text-xs sm:text-sm mb-4">Lompatan kurang tepat atau meleset dari teratai!</p>

            <div class="bg-emerald-950/70 p-4 rounded-2xl my-4 border border-emerald-500/40">
                <div class="text-xs text-emerald-300 uppercase font-bold tracking-wider">Skor Akhir</div>
                <div id="finalScoreText" class="text-4xl font-game text-yellow-400 my-1">0</div>
            </div>

            <button id="retryBtn" class="w-full py-3.5 bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-white font-game text-lg rounded-2xl shadow-xl border border-emerald-300/50 btn-bounce cursor-pointer">
                COBA LAGI 🔄
            </button>
        </div>
    </div>

    <script>
        // Web Audio API Synthesizer (No external sound assets needed)
        class AudioFX {
            constructor() {
                this.ctx = null;
                this.muted = false;
            }

            init() {
                if (!this.ctx) {
                    const AudioCtx = window.AudioContext || window.webkitAudioContext;
                    if (AudioCtx) {
                        this.ctx = new AudioCtx();
                    }
                }
                if (this.ctx && this.ctx.state === 'suspended') {
                    this.ctx.resume();
                }
            }

            playJump() {
                if (this.muted || !this.ctx) return;
                try {
                    const now = this.ctx.currentTime;
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(160, now);
                    osc.frequency.exponentialRampToValueAtTime(480, now + 0.18);

                    gain.gain.setValueAtTime(0.3, now);
                    gain.gain.linearRampToValueAtTime(0.01, now + 0.18);

                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start(now);
                    osc.stop(now + 0.18);
                } catch(e) {}
            }

            playSplash() {
                if (this.muted || !this.ctx) return;
                try {
                    const now = this.ctx.currentTime;
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(320, now);
                    osc.frequency.exponentialRampToValueAtTime(70, now + 0.3);

                    gain.gain.setValueAtTime(0.4, now);
                    gain.gain.linearRampToValueAtTime(0.01, now + 0.3);

                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start(now);
                    osc.stop(now + 0.3);
                } catch(e) {}
            }

            playSuccess() {
                if (this.muted || !this.ctx) return;
                try {
                    const now = this.ctx.currentTime;
                    [420, 560, 700].forEach((freq, i) => {
                        const osc = this.ctx.createOscillator();
                        const gain = this.ctx.createGain();
                        osc.type = 'sine';
                        osc.frequency.setValueAtTime(freq, now + i * 0.07);

                        gain.gain.setValueAtTime(0.2, now + i * 0.07);
                        gain.gain.linearRampToValueAtTime(0.01, now + i * 0.07 + 0.12);

                        osc.connect(gain);
                        gain.connect(this.ctx.destination);
                        osc.start(now + i * 0.07);
                        osc.stop(now + i * 0.07 + 0.12);
                    });
                } catch(e) {}
            }

            playWin() {
                if (this.muted || !this.ctx) return;
                try {
                    const now = this.ctx.currentTime;
                    [523.25, 659.25, 783.99, 1046.50].forEach((freq, i) => {
                        const osc = this.ctx.createOscillator();
                        const gain = this.ctx.createGain();
                        osc.type = 'triangle';
                        osc.frequency.setValueAtTime(freq, now + i * 0.1);

                        gain.gain.setValueAtTime(0.25, now + i * 0.1);
                        gain.gain.linearRampToValueAtTime(0.01, now + i * 0.1 + 0.2);

                        osc.connect(gain);
                        gain.connect(this.ctx.destination);
                        osc.start(now + i * 0.1);
                        osc.stop(now + i * 0.1 + 0.2);
                    });
                } catch(e) {}
            }
        }

        const audio = new AudioFX();

        const LEVEL_DATA = [
            { id: 1, name: "1 - Kolam Tenang", targetJumps: 5, padSpeed: 0, padRadius: 44 },
            { id: 2, name: "2 - Rawa Berangin", targetJumps: 6, padSpeed: 1.2, padRadius: 40 },
            { id: 3, name: "3 - Teratai Goyang", targetJumps: 8, padSpeed: 2.0, padRadius: 36 },
            { id: 4, name: "4 - Arus Deras", targetJumps: 10, padSpeed: 2.6, padRadius: 34 },
            { id: 5, name: "5 - Raja Kolam Emas", targetJumps: 12, padSpeed: 3.2, padRadius: 32 }
        ];

        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');

        // Game Engine Variables
        let gameState = 'START'; 
        let currentLevelIndex = 0;
        let score = 0;
        let successfulJumps = 0;

        // Input & Power Charge
        let isCharging = false;
        let chargePower = 0;
        let chargeDirection = 1;

        // Visual Effects
        let particles = [];
        let ripples = [];
        let flies = [];

        // Canvas Scale & Resolution Setup (HiDPI Retina support)
        let logicalWidth = 400;
        let logicalHeight = 600;

        function resizeCanvas() {
            const rect = canvas.parentElement.getBoundingClientRect();
            const dpr = window.devicePixelRatio || 1;
            
            logicalWidth = rect.width;
            logicalHeight = rect.height;

            canvas.width = rect.width * dpr;
            canvas.height = rect.height * dpr;

            ctx.resetTransform();
            ctx.scale(dpr, dpr);
        }

        window.addEventListener('resize', () => {
            resizeCanvas();
            if (gameState === 'PLAYING' && lilyPads.length >= 2) {
                // Adjust positions on window resize
                lilyPads[0].x = logicalWidth / 2;
                lilyPads[0].y = logicalHeight - 110;
                frog.x = lilyPads[0].x;
                frog.y = lilyPads[0].y;
            }
        });

        // Frog Character
        const frog = {
            x: 0,
            y: 0,
            radius: 18,
            startX: 0,
            startY: 0,
            targetX: 0,
            targetY: 0,
            jumpProgress: 0,
            scaleX: 1,
            scaleY: 1,
            isAirborne: false,

            reset(x, y) {
                this.x = x;
                this.y = y;
                this.startX = x;
                this.startY = y;
                this.targetX = x;
                this.targetY = y;
                this.jumpProgress = 0;
                this.isAirborne = false;
                this.scaleX = 1;
                this.scaleY = 1;
            },

            draw() {
                ctx.save();
                ctx.translate(this.x, this.y);

                if (isCharging) {
                    this.scaleX = 1 + (chargePower / 220);
                    this.scaleY = 1 - (chargePower / 320);
                } else if (this.isAirborne) {
                    this.scaleX = 0.85;
                    this.scaleY = 1.25;
                } else {
                    this.scaleX = 1;
                    this.scaleY = 1;
                }

                ctx.scale(this.scaleX, this.scaleY);

                // Shadow during airborne jump
                if (this.isAirborne) {
                    ctx.save();
                    ctx.fillStyle = 'rgba(0, 0, 0, 0.22)';
                    ctx.beginPath();
                    ctx.ellipse(0, 28, this.radius * 0.8, this.radius * 0.35, 0, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.restore();
                }

                // Green Frog Body
                ctx.fillStyle = '#4ade80';
                ctx.beginPath();
                ctx.ellipse(0, 0, this.radius * 1.1, this.radius, 0, 0, Math.PI * 2);
                ctx.fill();
                ctx.lineWidth = 2.5;
                ctx.strokeStyle = '#15803d';
                ctx.stroke();

                // Frog Eyes
                // Left Eye
                ctx.fillStyle = '#4ade80';
                ctx.beginPath();
                ctx.arc(-this.radius * 0.55, -this.radius * 0.65, 7, 0, Math.PI * 2);
                ctx.fill();
                ctx.stroke();
                ctx.fillStyle = '#ffffff';
                ctx.beginPath();
                ctx.arc(-this.radius * 0.55, -this.radius * 0.65, 4.5, 0, Math.PI * 2);
                ctx.fill();
                ctx.fillStyle = '#000000';
                ctx.beginPath();
                ctx.arc(-this.radius * 0.5, -this.radius * 0.65, 2, 0, Math.PI * 2);
                ctx.fill();

                // Right Eye
                ctx.fillStyle = '#4ade80';
                ctx.beginPath();
                ctx.arc(this.radius * 0.55, -this.radius * 0.65, 7, 0, Math.PI * 2);
                ctx.fill();
                ctx.stroke();
                ctx.fillStyle = '#ffffff';
                ctx.beginPath();
                ctx.arc(this.radius * 0.55, -this.radius * 0.65, 4.5, 0, Math.PI * 2);
                ctx.fill();
                ctx.fillStyle = '#000000';
                ctx.beginPath();
                ctx.arc(this.radius * 0.6, -this.radius * 0.65, 2, 0, Math.PI * 2);
                ctx.fill();

                // Cute Blush
                ctx.fillStyle = 'rgba(251, 113, 133, 0.6)';
                ctx.beginPath();
                ctx.arc(-this.radius * 0.65, 2, 3.5, 0, Math.PI * 2);
                ctx.arc(this.radius * 0.65, 2, 3.5, 0, Math.PI * 2);
                ctx.fill();

                // Smile
                ctx.strokeStyle = '#166534';
                ctx.lineWidth = 2;
                ctx.beginPath();
                ctx.arc(0, 2, 4.5, 0.1 * Math.PI, 0.9 * Math.PI);
                ctx.stroke();

                ctx.restore();
            }
        };

        // Lily Pads Management
        let lilyPads = [];

        class LilyPad {
            constructor(x, y, radius, speed = 0, isCurrent = false) {
                this.x = x;
                this.y = y;
                this.radius = radius;
                this.speed = speed;
                this.dir = Math.random() < 0.5 ? 1 : -1;
                this.isCurrent = isCurrent;
                this.flowerColor = ['#f472b6', '#fbbf24', '#a78bfa'][Math.floor(Math.random() * 3)];
            }

            update(maxWidth) {
                if (this.speed !== 0 && !this.isCurrent) {
                    this.x += this.speed * this.dir;
                    const margin = this.radius + 15;
                    if (this.x < margin) {
                        this.x = margin;
                        this.dir *= -1;
                    } else if (this.x > maxWidth - margin) {
                        this.x = maxWidth - margin;
                        this.dir *= -1;
                    }
                }
            }

            draw() {
                ctx.save();
                ctx.translate(this.x, this.y);

                // Water Shadow
                ctx.fillStyle = 'rgba(6, 78, 59, 0.35)';
                ctx.beginPath();
                ctx.arc(3, 5, this.radius, 0, Math.PI * 2);
                ctx.fill();

                // Green Lily Pad Circle with Cutout
                ctx.fillStyle = this.isCurrent ? '#10b981' : '#059669';
                ctx.beginPath();
                ctx.arc(0, 0, this.radius, 0.25 * Math.PI, 1.9 * Math.PI);
                ctx.lineTo(0, 0);
                ctx.closePath();
                ctx.fill();

                ctx.lineWidth = 2.5;
                ctx.strokeStyle = '#047857';
                ctx.stroke();

                // Vein Lines
                ctx.strokeStyle = 'rgba(167, 243, 208, 0.35)';
                ctx.lineWidth = 1.5;
                for (let i = 0; i < 4; i++) {
                    const angle = (i * Math.PI / 2.5) + 0.5;
                    ctx.beginPath();
                    ctx.moveTo(0, 0);
                    ctx.lineTo(Math.cos(angle) * (this.radius * 0.8), Math.sin(angle) * (this.radius * 0.8));
                    ctx.stroke();
                }

                // Center Flower
                ctx.fillStyle = this.flowerColor;
                ctx.beginPath();
                ctx.arc(0, 0, this.radius * 0.22, 0, Math.PI * 2);
                ctx.fill();
                ctx.fillStyle = '#fef08a';
                ctx.beginPath();
                ctx.arc(0, 0, this.radius * 0.09, 0, Math.PI * 2);
                ctx.fill();

                ctx.restore();
            }
        }

        function spawnFlies(padX, padY) {
            if (Math.random() < 0.65) {
                flies.push({
                    x: padX + (Math.random() - 0.5) * 40,
                    y: padY - 30 - Math.random() * 25,
                    radius: 3.5,
                    collected: false,
                    angle: Math.random() * Math.PI * 2
                });
            }
        }

        function createPondLayout() {
            lilyPads = [];
            flies = [];

            const lvl = LEVEL_DATA[currentLevelIndex];
            const padRadius = lvl.padRadius;
            const startX = logicalWidth / 2;
            const startY = logicalHeight - 110;

            // Current Lily Pad
            lilyPads.push(new LilyPad(startX, startY, padRadius + 8, 0, true));
            frog.reset(startX, startY);

            // Target Lily Pad
            const targetX = logicalWidth * (0.28 + Math.random() * 0.44);
            const targetY = logicalHeight * 0.38;

            lilyPads.push(new LilyPad(targetX, targetY, padRadius, lvl.padSpeed, false));
            spawnFlies(targetX, targetY);

            // Update UI HUD
            document.getElementById('targetDisplay').innerText = `${successfulJumps}/${lvl.targetJumps}`;
            document.getElementById('levelDisplay').innerText = lvl.name;
        }

        function startCharging() {
            if (gameState !== 'PLAYING' || frog.isAirborne) return;
            audio.init();
            isCharging = true;
            document.getElementById('powerContainer').classList.remove('opacity-0');
        }

        function releaseJump() {
            if (!isCharging || gameState !== 'PLAYING') return;
            isCharging = false;
            document.getElementById('powerContainer').classList.add('opacity-0');

            const currentPad = lilyPads[0];
            const targetPad = lilyPads[1];

            const distanceFactor = (chargePower / 100);
            const distToTarget = Math.hypot(targetPad.x - currentPad.x, targetPad.y - currentPad.y);
            const totalJumpDist = distToTarget * (distanceFactor * 1.48);

            const angle = Math.atan2(targetPad.y - currentPad.y, targetPad.x - currentPad.x);

            frog.startX = frog.x;
            frog.startY = frog.y;
            frog.targetX = frog.x + Math.cos(angle) * totalJumpDist;
            frog.targetY = frog.y + Math.sin(angle) * totalJumpDist;

            frog.jumpProgress = 0;
            frog.isAirborne = true;

            audio.playJump();
            chargePower = 0;
        }

        // Event Listeners (Keyboard + Mouse + Touch)
        window.addEventListener('keydown', (e) => {
            if (e.code === 'Space' && !e.repeat) {
                e.preventDefault();
                startCharging();
            }
        });

        window.addEventListener('keyup', (e) => {
            if (e.code === 'Space') {
                e.preventDefault();
                releaseJump();
            }
        });

        // Touch & Mouse Support on Canvas
        const handleTouchStart = (e) => {
            if (e.target.closest('#soundBtn')) return;
            e.preventDefault();
            startCharging();
        };

        const handleTouchEnd = (e) => {
            if (e.target.closest('#soundBtn')) return;
            e.preventDefault();
            releaseJump();
        };

        canvas.addEventListener('mousedown', handleTouchStart);
        canvas.addEventListener('mouseup', handleTouchEnd);
        canvas.addEventListener('touchstart', handleTouchStart, { passive: false });
        canvas.addEventListener('touchend', handleTouchEnd, { passive: false });

        function createSplash(x, y) {
            for (let i = 0; i < 16; i++) {
                const angle = Math.random() * Math.PI * 2;
                const speed = 2 + Math.random() * 4.5;
                particles.push({
                    x: x,
                    y: y,
                    vx: Math.cos(angle) * speed,
                    vy: Math.sin(angle) * speed,
                    radius: 2.5 + Math.random() * 3.5,
                    color: '#a5f3fc',
                    life: 1,
                    decay: 0.035
                });
            }
            ripples.push({ x, y, radius: 4, maxRadius: 36, opacity: 1 });
        }

        function createSparkles(x, y) {
            for (let i = 0; i < 12; i++) {
                const angle = Math.random() * Math.PI * 2;
                const speed = 1 + Math.random() * 3;
                particles.push({
                    x: x,
                    y: y,
                    vx: Math.cos(angle) * speed,
                    vy: Math.sin(angle) * speed,
                    radius: 2 + Math.random() * 3,
                    color: '#fef08a',
                    life: 1,
                    decay: 0.025
                });
            }
        }

        function checkLanding() {
            const targetPad = lilyPads[1];
            const dist = Math.hypot(frog.x - targetPad.x, frog.y - targetPad.y);

            // Check if within lily pad bounds
            if (dist <= targetPad.radius + (frog.radius * 0.4)) {
                audio.playSuccess();
                createSparkles(frog.x, frog.y);

                let bonus = 100;
                if (dist < 12) {
                    bonus += 50; // Perfect Center Landing Bonus
                }

                score += bonus;
                successfulJumps++;

                document.getElementById('scoreDisplay').innerText = score;
                const lvl = LEVEL_DATA[currentLevelIndex];
                document.getElementById('targetDisplay').innerText = `${successfulJumps}/${lvl.targetJumps}`;

                if (successfulJumps >= lvl.targetJumps) {
                    setTimeout(() => {
                        audio.playWin();
                        if (currentLevelIndex < LEVEL_DATA.length - 1) {
                            document.getElementById('levelScoreText').innerText = score;
                            document.getElementById('levelModal').classList.remove('hidden');
                        } else {
                            document.getElementById('levelCompleteSub').innerText = "SELAMAT! Kamu Menamatkan Semua Kolam!";
                            document.getElementById('levelScoreText').innerText = score;
                            document.getElementById('levelModal').classList.remove('hidden');
                        }
                    }, 350);
                } else {
                    setTimeout(shiftPadsForward, 280);
                }
            } else {
                audio.playSplash();
                createSplash(frog.x, frog.y);
                gameState = 'SPLASH';

                setTimeout(() => {
                    document.getElementById('finalScoreText').innerText = score;
                    document.getElementById('gameOverModal').classList.remove('hidden');
                }, 750);
            }
        }

        function shiftPadsForward() {
            lilyPads.shift();
            lilyPads[0].isCurrent = true;

            const lvl = LEVEL_DATA[currentLevelIndex];
            const newTargetX = logicalWidth * (0.25 + Math.random() * 0.5);
            const newTargetY = logicalHeight * 0.38;

            lilyPads.push(new LilyPad(newTargetX, newTargetY, lvl.padRadius, lvl.padSpeed, false));
            spawnFlies(newTargetX, newTargetY);

            frog.reset(lilyPads[0].x, lilyPads[0].y);
        }

        function update() {
            // Charging Power Oscillation
            if (isCharging) {
                chargePower += 2.4 * chargeDirection;
                if (chargePower >= 100) {
                    chargePower = 100;
                    chargeDirection = -1;
                } else if (chargePower <= 0) {
                    chargePower = 0;
                    chargeDirection = 1;
                }
                document.getElementById('powerBar').style.width = chargePower + '%';
                document.getElementById('powerPercent').innerText = Math.round(chargePower) + '%';
            }

            // Update Lily Pads
            lilyPads.forEach(pad => pad.update(logicalWidth));

            // Flies Update & Catch Collision
            flies.forEach(fly => {
                fly.angle += 0.05;
                fly.y += Math.sin(fly.angle) * 0.4;

                if (frog.isAirborne && !fly.collected) {
                    const d = Math.hypot(frog.x - fly.x, frog.y - fly.y);
                    if (d < frog.radius + 12) {
                        fly.collected = true;
                        score += 50;
                        document.getElementById('scoreDisplay').innerText = score;
                        createSparkles(fly.x, fly.y);
                    }
                }
            });

            // Frog Arc Jumping Physics
            if (frog.isAirborne) {
                frog.jumpProgress += 0.045;

                if (frog.jumpProgress >= 1) {
                    frog.jumpProgress = 1;
                    frog.isAirborne = false;
                    frog.x = frog.targetX;
                    frog.y = frog.targetY;
                    checkLanding();
                } else {
                    frog.x = frog.startX + (frog.targetX - frog.startX) * frog.jumpProgress;
                    frog.y = frog.startY + (frog.targetY - frog.startY) * frog.jumpProgress;

                    // Parabolic Arc Height
                    const arcHeight = 110 * Math.sin(frog.jumpProgress * Math.PI);
                    frog.y -= arcHeight;
                }
            }

            // Particles Update
            for (let i = particles.length - 1; i >= 0; i--) {
                const p = particles[i];
                p.x += p.vx;
                p.y += p.vy;
                p.life -= p.decay;
                if (p.life <= 0) particles.splice(i, 1);
            }

            // Ripples Update
            for (let i = ripples.length - 1; i >= 0; i--) {
                const r = ripples[i];
                r.radius += 1.4;
                r.opacity -= 0.025;
                if (r.opacity <= 0) ripples.splice(i, 1);
            }
        }

        function drawBackground() {
            // Water Gradient Background
            const grad = ctx.createLinearGradient(0, 0, 0, logicalHeight);
            grad.addColorStop(0, '#042f2e');
            grad.addColorStop(0.5, '#0d9488');
            grad.addColorStop(1, '#115e59');
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, logicalWidth, logicalHeight);

            // Subtle Water Ripple Lines
            ctx.strokeStyle = 'rgba(204, 251, 241, 0.08)';
            ctx.lineWidth = 1.5;
            const time = Date.now() * 0.001;
            for (let y = 30; y < logicalHeight; y += 55) {
                ctx.beginPath();
                for (let x = 0; x < logicalWidth; x += 18) {
                    const waveY = y + Math.sin(x * 0.02 + time) * 3.5;
                    if (x === 0) ctx.moveTo(x, waveY);
                    else ctx.lineTo(x, waveY);
                }
                ctx.stroke();
            }

            // Splash Water Ripples
            ripples.forEach(r => {
                ctx.strokeStyle = `rgba(165, 243, 252, ${r.opacity})`;
                ctx.lineWidth = 2;
                ctx.beginPath();
                ctx.arc(r.x, r.y, r.radius, 0, Math.PI * 2);
                ctx.stroke();
            });
        }

        function render() {
            ctx.clearRect(0, 0, logicalWidth, logicalHeight);

            // 1. Draw Background Water
            drawBackground();

            // 2. Trajectory Helper Line (while charging)
            if (isCharging && lilyPads.length > 1) {
                const currentPad = lilyPads[0];
                const targetPad = lilyPads[1];
                const distToTarget = Math.hypot(targetPad.x - currentPad.x, targetPad.y - currentPad.y);
                const totalJumpDist = distToTarget * ((chargePower / 100) * 1.48);
                const angle = Math.atan2(targetPad.y - currentPad.y, targetPad.x - currentPad.x);

                const projectedX = currentPad.x + Math.cos(angle) * totalJumpDist;
                const projectedY = currentPad.y + Math.sin(angle) * totalJumpDist;

                ctx.save();
                ctx.strokeStyle = 'rgba(254, 240, 138, 0.75)';
                ctx.lineWidth = 2.5;
                ctx.setLineDash([5, 5]);
                ctx.beginPath();
                ctx.moveTo(currentPad.x, currentPad.y);
                ctx.quadraticCurveTo(
                    (currentPad.x + projectedX) / 2,
                    Math.min(currentPad.y, projectedY) - 75,
                    projectedX,
                    projectedY
                );
                ctx.stroke();

                // Target Landing Spot Marker
                ctx.fillStyle = '#fde047';
                ctx.beginPath();
                ctx.arc(projectedX, projectedY, 5.5, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }

            // 3. Draw Lily Pads
            lilyPads.forEach(pad => pad.draw());

            // 4. Draw Flies
            flies.forEach(fly => {
                if (!fly.collected) {
                    ctx.save();
                    ctx.fillStyle = '#fef08a';
                    ctx.beginPath();
                    ctx.arc(fly.x, fly.y, fly.radius, 0, Math.PI * 2);
                    ctx.fill();

                    // Wings animation
                    ctx.fillStyle = 'rgba(255, 255, 255, 0.75)';
                    ctx.beginPath();
                    ctx.ellipse(fly.x - 2.5, fly.y - 2.5, 3.5, 1.8, Math.PI / 4, 0, Math.PI * 2);
                    ctx.ellipse(fly.x + 2.5, fly.y - 2.5, 3.5, 1.8, -Math.PI / 4, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.restore();
                }
            });

            // 5. Draw Frog
            if (gameState !== 'SPLASH') {
                frog.draw();
            }

            // 6. Draw Particles
            particles.forEach(p => {
                ctx.fillStyle = p.color;
                ctx.globalAlpha = p.life;
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                ctx.fill();
                ctx.globalAlpha = 1;
            });
        }

        function gameLoop() {
            update();
            render();
            requestAnimationFrame(gameLoop);
        }

        function startGame() {
            score = 0;
            successfulJumps = 0;
            currentLevelIndex = 0;
            gameState = 'PLAYING';

            document.getElementById('scoreDisplay').innerText = '0';
            document.getElementById('startModal').classList.add('hidden');
            document.getElementById('gameOverModal').classList.add('hidden');
            document.getElementById('levelModal').classList.add('hidden');

            resizeCanvas();
            createPondLayout();
        }

        document.getElementById('startBtn').addEventListener('click', startGame);
        document.getElementById('retryBtn').addEventListener('click', startGame);

        document.getElementById('nextLevelBtn').addEventListener('click', () => {
            if (currentLevelIndex < LEVEL_DATA.length - 1) {
                currentLevelIndex++;
                successfulJumps = 0;
                gameState = 'PLAYING';
                document.getElementById('levelModal').classList.add('hidden');
                createPondLayout();
            } else {
                startGame();
            }
        });

        // Sound Mute Toggle Button
        const soundBtn = document.getElementById('soundBtn');
        soundBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            audio.init();
            audio.muted = !audio.muted;
            soundBtn.innerText = audio.muted ? '🔇' : '🔊';
        });

        // Boot Game on Window Load
        window.addEventListener('load', () => {
            resizeCanvas();
            gameLoop();
        });
    </script>
</body>
</html>
